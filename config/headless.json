{
  "mode": "aggregate",
  "native_roles": {"coordinator": "current"},
  "cloud_defaults": {
    "model": "sonnet",
    "allowed_models": ["sonnet", "opus"],
    "funding_max_age_minutes": 60
  },
  "claude_local_defaults": {
    "model": "sonnet",
    "allowed_models": ["opus", "sonnet", "haiku"],
    "funding_max_age_minutes": 60
  },
  "agy_routes": {
    "l1": "gemini-3.8-flash-high",
    "l2": "gemini-3.8-flash-high",
    "l3": ["claude-opus-4-6-thinking", "gemini-3.8-flash-high"]
  },
  "fallback_routes": {
    "l1": "claude-local:sonnet",
    "l2": "claude-local:sonnet",
    "l3": "claude-local:opus"
  },
  "agy_alternatives": {
    "l1": ["claude-sonnet-4-6", "gpt-oss-120b-medium"],
    "l2": ["claude-opus-4-6-thinking", "gemini-3.8-flash-high", "gpt-oss-120b-medium"]
  },
  "auto_funding": {
    "priority": ["included_subscription", "authorized_cloud_credit", "authorized_prepaid_api"],
    "prepaid_requires_explicit_authorization": true
  },
  "api_advisors": {
    "providers": ["glm", "deepseek", "minimax"],
    "roles": ["planning", "read_only_review"],
    "funding": "prepaid_api"
  },
  "quota_handoff": {
    "decider_candidates": ["gpt-6-astra", "fable", "opus5.5", "muse"],
    "decision_required": true,
    "on_unavailable": "retain_and_report"
  },
  "providers": {
    "openai": {"model": "gpt-4o", "display_name": "GPT-4o"},
    "anthropic": {"model": "claude-3-5-sonnet-20240620", "display_name": "Claude-3.5-Sonnet"},
    "glm": {"model": "glm-5.3-flash", "display_name": "GLM-5.3-Flash"},
    "deepseek": {"model": "deepseek-chat", "display_name": "DeepSeek-Chat"},
    "minimax": {"model": "MiniMax-M3", "display_name": "MiniMax-M3"},
    "gemini": {"model": "gemini-3.8-flash", "display_name": "Gemini-3.8-Flash"},
    "codex": {"model": "gpt-6-astra", "display_name": "Codex-CLI"}
  },
  "worker_defaults": ["openai", "anthropic", "glm", "deepseek", "minimax", "gemini", "codex"],
  "aggregation_priority": ["anthropic", "openai", "gemini", "deepseek", "glm"],
  "reviewer": {"provider": "glm", "model": "glm-5.2", "display_name": "GLM-5.2"}
}

